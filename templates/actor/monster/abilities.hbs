<section class="tab abilities {{tabs.abilities.cssClass}}" data-group="primary" data-tab="abilities">
   <div class="flexrow align-vtop">
      <div class="flex1" style="max-width: 180px;">
         {{> "actorHpAc"}}
         <div class="flexrow">
            <!-- SAVING THROWS -->
            {{> "actorSaves"}}
         </div>         
      </div>
      <div class="flex2">
         {{#if (fadeor attackGroups specialAbilities)}}
         <div class="bordered">
            {{#if attackGroups}}
            {{!-- Equipped Weapons --}}
            {{> "attackGroups"}}
            {{/if}}
            {{#if specialAbilities}}
            {{!-- Special Abilities --}}
            {{> "actorSpecialAbilities"}}
            {{/if}}
         </div>
         {{/if}}
         <div class="flexrow">
            {{> "actorMovementModes"}}
         </div>
         {{#if hasAbilityScores}}
         <!-- ABILITY SCORES -->
         {{> "abilityScores"}}
         {{/if}}
      </div>
   </div>
</section>